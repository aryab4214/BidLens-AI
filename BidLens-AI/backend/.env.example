# BidLens AI — Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env to GitHub (it's in .gitignore)

# ── AI Models ─────────────────────────────────────────────
# Option A: Gemini API (free tier) — get from aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Option B: Groq API (free, very fast) — get from console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Option C: Ollama (100% free, runs locally, no key needed)
OLLAMA_BASE_URL=http://localhost:11434

# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/bidlens

# ── Government APIs ───────────────────────────────────────
GSTN_API_KEY=your_gstn_api_key_here
GSTN_API_URL=https://api.gst.gov.in/commonapi/v1.1

# ── App Config ────────────────────────────────────────────
APP_ENV=development
UPLOAD_DIR=uploaded_docs
MAX_FILE_SIZE_MB=50
