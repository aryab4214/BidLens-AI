# BidLens AI — .gitignore

# ─── Python / Backend ────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/
.mypy_cache/
.pytest_cache/
.tox/

# Virtual Environments
venv/
.venv/
env/
ENV/

# Backend runtime directories
backend/uploaded_docs/
backend/generated_reports/
backend/signatures/

# Environment variables (NEVER commit secrets)
.env
.env.local
.env.production

# ─── Node / Frontend ─────────────────────────────
node_modules/
.next/
out/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ─── OS Files ────────────────────────────────────
.DS_Store
Thumbs.db
*.swp

# ─── IDE ─────────────────────────────────────────
.vscode/
.idea/
*.suo
